# Frontend (web + Capacitor) config — copy to .env and fill in real values.
# These are the Firebase Web SDK config values (Firebase console > Project
# settings > General > Your apps > Web app). They identify which Firebase
# *project* the app talks to; they are not secrets — see
# https://firebase.google.com/docs/projects/api-keys — but are still
# env-driven rather than hardcoded so a different environment (staging, a
# teammate's own Firebase project) never requires a source change.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave unset for a normal build (talks to the real Firebase project above).
# Set only by `npm run dev:local` / `make local` to point the app at this
# laptop's Firebase Emulator Suite instead.
VITE_FIREBASE_EMULATOR_HOST=

# Set to true only once android/app/google-services.json exists (Firebase console >
# Project settings > Android app). Without that file, native push registration crashes
# the app on launch. Leave unset to run without push notifications. With it unset, technicians
# get NO push for new/reassigned/cancelled jobs — set it to true in any build you ship to phones.
VITE_ENABLE_PUSH=

# Business settings for LOCAL testing only (every name and default is in
# functions/src/shared/settings.ts). They apply only when the app and functions
# run against the local emulators; production reads the Firestore document
# config/app instead (`make settings-show` / `make settings-set`). Leave a line
# out to use its default.
# SETTING_OTP_REUSE_SECONDS=180
# SETTING_OTP_MAX_SENDS_PER_HOUR=3
# SETTING_OTP_MAX_WRONG_CODES=5
# SETTING_TECHNICIAN_MIN_AGE=18
# SETTING_TECHNICIAN_MAX_AGE=70
# SETTING_MAX_EXPERIENCE_YEARS=50
# SETTING_PROFILE_UPDATE_LIFETIME_CAP=2
# SETTING_SUPPORT_PHONE_NUMBER=9646424964
