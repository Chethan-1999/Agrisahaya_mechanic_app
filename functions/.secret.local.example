# Secret Manager values for the LOCAL emulator only — copy to .secret.local (this directory). The emulator reads
# secrets from .secret.local; `firebase deploy` never uploads it. Production stores them in Secret Manager:
#   firebase functions:secrets:set SMS_GATE_USERNAME
#   firebase functions:secrets:set SMS_GATE_PASSWORD

# SMS Gateway for Android (used when SMS_PROVIDER=sms-gate): the Username and Password the gateway app shows under
# "Cloud server" once it's online.
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
