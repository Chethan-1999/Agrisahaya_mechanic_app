# Backend-local config — copy to .env (this directory) and fill in real values.
# Only used by one-off local Admin SDK scripts (scripts/create-admin.ts), never
# read by the deployed Cloud Functions themselves: those get their credentials
# and project id from the Cloud Functions runtime automatically, and the
# Auth/Firestore/Functions emulators get their project id from ../.firebaserc.
# Keeping this separate from the frontend's .env is what makes the backend
# independently configurable — no shared file, no shared literal.

# Path to a service account key JSON, needed only to run create-admin.ts
# against a real (non-emulator) Firebase project. Download one from Firebase
# console > Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=
