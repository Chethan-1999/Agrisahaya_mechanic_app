# Backend config for the deployed Cloud Functions — copy to .env (this directory)
# only if you need to override a default. `firebase deploy` uploads this file (and
# .env.<project-id>) as the deployed functions' environment, so everything here
# must make sense in the cloud.
#
# NEVER put GOOGLE_APPLICATION_CREDENTIALS here: a laptop path makes every deployed
# function crash on startup ("Failed to read credentials from file ..."). The local
# Admin SDK scripts (scripts/create-admin.ts) read it from .env.scripts instead —
# see .env.scripts.example. Deployed functions get their credentials and project id
# from the Cloud Functions runtime automatically; the emulators get their project
# id from ../.firebaserc.

# Lifetime cap on profile-change requests a technician may submit
# (lib/params.ts, a `firebase-functions/params` value resolved at deploy time).
# Optional — defaults to 2 if unset. Override per deployed project via
# .env.<project-id> instead of editing this default.
PROFILE_UPDATE_LIFETIME_CAP=2
