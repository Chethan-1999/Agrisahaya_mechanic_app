# Backend-local config — copy to .env (this directory) and fill in real values.
# Most of this is only used by one-off local Admin SDK scripts
# (scripts/create-admin.ts), never read by the deployed Cloud Functions
# themselves: those get their credentials and project id from the Cloud
# Functions runtime automatically, and the Auth/Firestore/Functions emulators
# get their project id from ../.firebaserc. Keeping this separate from the
# frontend's .env is what makes the backend independently configurable — no
# shared file, no shared literal.
#
# The one exception is PROFILE_UPDATE_LIFETIME_CAP (see lib/params.ts), a
# `firebase-functions/params` value — it IS read by the deployed functions,
# resolved at deploy time. Override it per deployed project via
# .env.<project-id> instead of editing this file's default.

# Path to a service account key JSON, needed only to run create-admin.ts
# against a real (non-emulator) Firebase project. Download one from Firebase
# console > Project settings > Service accounts > Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=

# Lifetime cap on profile-change requests a technician may submit. Optional —
# defaults to 2 if unset.
PROFILE_UPDATE_LIFETIME_CAP=2
