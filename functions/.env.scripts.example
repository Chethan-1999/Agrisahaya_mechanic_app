# Config for the local one-off Admin SDK scripts only (scripts/create-admin.ts) —
# copy to .env.scripts (this directory). `firebase deploy` never uploads this file,
# unlike .env, so a laptop path is safe here.

# Path to a service account key JSON, needed only to run create-admin.ts against
# the real (non-emulator) Firebase project. Download one from Firebase console >
# Project settings > Service accounts > Generate new private key. Keep the key out
# of git (keys/ at the repo root is gitignored).
GOOGLE_APPLICATION_CREDENTIALS=
