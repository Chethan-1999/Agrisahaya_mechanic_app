# Environment for the LOCAL Firebase emulator only — copy to .env.local (this
# directory). The emulator loads .env.local; `firebase deploy` never uploads it,
# so nothing here can reach production.

# Fixed auth header for local testing: a callable request with
#   X-Local-Auth: <LOCAL_AUTH_TOKEN>
# runs as LOCAL_AUTH_UID (or the uid in an X-Local-Uid header) without a real
# sign-in. See src/lib/onCall.ts and `make call`. Pick any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LOCAL_AUTH_TOKEN=
# Uid to act as by default — usually the local admin's (`make admin` prints it,
# or look it up in the emulator UI > Authentication).
LOCAL_AUTH_UID=

# Which SMS provider sendSms uses (functions/src/lib/sms.ts): `none` (default — only logs) or `sms-gate` (the
# SMS Gateway for Android phone; its credentials go in functions/.secret.local). Production sets this in
# functions/.env.<project-id> instead.
SMS_PROVIDER=none
