{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "scripts"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/privacy-policy.html", "destination": "/privacy-policy.html" },
      { "source": "/data-deletion.html", "destination": "/data-deletion.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "auth": { "host": "0.0.0.0", "port": 9099 },
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "functions": { "host": "0.0.0.0", "port": 5001 },
    "ui": { "enabled": true, "host": "0.0.0.0", "port": 4000 },
    "singleProjectMode": true
  }
}
